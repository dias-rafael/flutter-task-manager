{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "flutter-task-manager (debug mode)",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter-task-manager (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter-task-manager (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
        "name": "Flutter Web (Chrome - Disable CORS)",
        "request": "launch",
        "type": "dart",
        "flutterMode": "debug",
        "deviceId": "chrome",
        "args": [
            "--web-browser-flag=--disable-web-security",
            "--web-browser-flag=--disable-site-isolation-trials",
            "--web-port=8080"
        ]
        }
    ]
}